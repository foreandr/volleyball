config_version=5

[application]
config/name="Volleyball"
config/version="0.1.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/positional_shadow/atlas_size=8192
environment/ssao/quality=4
environment/ssil/quality=4
renderer/rendering_method.mobile="gl_compatibility"

[autoload]
StorySession="*res://scripts/story_session.gd"
MenuPresentation="*res://scripts/menu_presentation.gd"
CareerSession="*res://scripts/career_session.gd"
InteractionTrace="*res://scripts/interaction_trace.gd"
GameRecording="*res://scripts/game_recording.gd"
